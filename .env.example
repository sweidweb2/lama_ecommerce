# Supabase / app (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (backup extract — preferred for fullest dumps)
# Prefer installing PostgreSQL client tools so `pg_dump` is on PATH.
# If unset, extract falls back to Supabase service-role data export.
DATABASE_URL=
SUPABASE_DB_URL=

# AES-256-GCM key: 64 hex characters (32 bytes)
ENCRYPTION_KEY=

# Future payments (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Transactional email (Resend) — order confirmation after checkout
RESEND_API_KEY=
EMAIL_FROM=
# Optional: public site origin for order details links in emails
EMAIL_ORDER_DETAILS_BASE_URL=
# NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Playwright E2E (optional — tests skip when unset)
# Loaded by playwright.config.ts from .env.local
# Default server: http://127.0.0.1:3005  →  $env:E2E_RUN="1"; npm run test:e2e
# ---------------------------------------------------------------------------
E2E_RUN=
E2E_PORT=3005
E2E_BASE_URL=http://127.0.0.1:3005
# Set to 1 only if THIS app is already running on E2E_PORT
E2E_REUSE_SERVER=

# Matches scripts/seed-admin.ts defaults (run: npm run seed:admin)
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=password

# Customer storefront account (create in Supabase / admin users)
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# Inactive customer (profiles.is_active = false)
E2E_INACTIVE_EMAIL=
E2E_INACTIVE_PASSWORD=
