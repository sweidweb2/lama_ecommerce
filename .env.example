# Supabase / app (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (backup extract / ops — use one)
DATABASE_URL=
SUPABASE_DB_URL=

# AES-256-GCM key: 64 hex characters (32 bytes)
ENCRYPTION_KEY=

# Future payments (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Transactional email (Resend) — order confirmation after checkout
RESEND_API_KEY=
EMAIL_FROM=
# Optional: public site origin for order details links in emails
EMAIL_ORDER_DETAILS_BASE_URL=
