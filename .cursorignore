# Index and agent access ignore. App source, docs, tests, Supabase
# migrations, and config stay visible. Patterns follow .gitignore syntax.

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/

# Build output and framework caches
.next/
out/
dist/
build/
.expo/
.expo-shared/
web-build/
.turbo/
.vercel/
.swc/

# Tooling caches
*.tsbuildinfo
next-env.d.ts
.cache/
.eslintcache

# Test output
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/
playwright/.auth/
e2e/.auth/

# Logs and local build dumps
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
build_output.txt

# Local env and secrets. .env.example stays readable.
.env
.env.*
!.env.example
*.pem
.env.keys
supabase/.env
supabase/.env.*

# Supabase CLI machine state (migrations and config.toml stay visible)
supabase/.branches/
supabase/.temp/

# Media and binary asset dumps
public/**/*.jpg
public/**/*.jpeg
public/**/*.png
public/**/*.gif
public/**/*.webp
public/**/*.ico
public/**/*.avif
public/**/*.svg
public/**/*.bmp
public/**/*.woff
public/**/*.woff2
public/**/*.ttf
public/**/*.otf
public/**/*.eot
public/**/*.mp4
public/**/*.webm
public/**/*.mov
public/**/*.mp3
public/**/*.wav
public/**/*.pdf

# OS junk
.DS_Store
Thumbs.db
